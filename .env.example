# Шаблон конфигурации Personal AI Hub.
# НЕ содержит рабочих секретов. Скопируйте в .env и замените значения.
# `make bootstrap` сгенерирует безопасные случайные значения автоматически.

# Режим приложения: production | development
APP_ENV=production

# Адрес, на котором хост слушает порты. 127.0.0.1 = только локально.
# Для LAN/внешнего доступа укажите 0.0.0.0 (осознанно, с HTTPS и авторизацией).
APP_BIND_HOST=127.0.0.1

# Публичный базовый URL фронтенда (для CORS и ссылок).
APP_BASE_URL=http://localhost:3000

# URL API для браузера (клиентский вызов). В LAN-режиме замените на IP хоста.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Порты хоста.
API_PORT=8000
WEB_PORT=3000

# Мастер-ключ шифрования провайдерских ключей (32+ байта, генерируется bootstrap).
APP_MASTER_KEY=CHANGE_ME_WITH_32_BYTE_RANDOM_SECRET

# PostgreSQL. DATABASE_URL собирается автоматически из POSTGRES_PASSWORD;
# при необходимости (env-only/CI) задайте его явно.
POSTGRES_PASSWORD=CHANGE_ME

# Valkey (совместимый с Redis)
VALKEY_URL=redis://valkey:6379/0

# Qdrant (векторный индекс)
QDRANT_URL=http://qdrant:6333

# Хранилище файлов
BLOB_STORE_DRIVER=local
BLOB_LOCAL_ROOT=/data/assets

# Логирование и тесты
LOG_LEVEL=INFO
RUN_LIVE_TESTS=0

# (Опционально) Автосоздание первого администратора при пустой БД.
# Полезно для CI/автоматизированной установки. Пароль не логируется.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
