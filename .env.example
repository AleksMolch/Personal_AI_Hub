# Шаблон конфигурации Personal AI Hub.
# НЕ содержит рабочих секретов. Скопируйте в .env и замените значения.
# `make bootstrap` сгенерирует безопасные случайные значения автоматически.

# Режим приложения: production | development
APP_ENV=production

# Адрес, на котором хост слушает порты. 127.0.0.1 = только локально.
# Для LAN/внешнего доступа укажите 0.0.0.0 (осознанно, с HTTPS и авторизацией).
APP_BIND_HOST=127.0.0.1

# Публичный базовый URL фронтенда (для CORS и ссылок).
APP_BASE_URL=http://localhost:3000

# URL API для браузера (клиентский вызов). В LAN-режиме замените на IP хоста.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Порты хоста.
API_PORT=8000
WEB_PORT=3000

# Мастер-ключ шифрования провайдерских ключей (32+ байта, генерируется bootstrap).
APP_MASTER_KEY=CHANGE_ME_WITH_32_BYTE_RANDOM_SECRET

# PostgreSQL. DATABASE_URL собирается автоматически из POSTGRES_PASSWORD;
# при необходимости (env-only/CI) задайте его явно.
POSTGRES_PASSWORD=CHANGE_ME

# Valkey (совместимый с Redis)
VALKEY_URL=redis://valkey:6379/0

# Qdrant (векторный индекс)
QDRANT_URL=http://qdrant:6333

# Хранилище файлов
BLOB_STORE_DRIVER=local
BLOB_LOCAL_ROOT=/data/assets

# OCR сканов: backend (tesseract | rapidocr | auto) и лимиты ресурсов.
# rapidocr = ONNX-рантайм (не входит в базовые зависимости, ставится отдельно,
# см. README_staff). auto: RapidOCR при доступности, иначе Tesseract.
OCR_BACKEND=tesseract
OCR_LANGUAGES=rus,eng
OCR_MAX_PAGES=40
OCR_MAX_IMAGE_SIDE=3500
OCR_PAGE_TIMEOUT_SECONDS=30.0

# Логирование и тесты
LOG_LEVEL=INFO
RUN_LIVE_TESTS=0

# (Опционально) Локальный LiteLLM proxy, ADR-0004. Основной стек работает
# без этих переменных: сервис включается только через compose-профиль
# `litellm` (make up-litellm). Бюджет и цены считает Personal AI Hub.
# LITELLM_MASTER_KEY=
# LITELLM_PORT=4000
# LITELLM_UPSTREAM_API_KEY=
# LITELLM_UPSTREAM_API_BASE=https://api.openrouter.ai/api/v1
# LITELLM_UPSTREAM_MODEL=openai/gpt-4o-mini

# (Опционально) Автосоздание первого администратора при пустой БД.
# Полезно для CI/автоматизированной установки. Пароль не логируется.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
